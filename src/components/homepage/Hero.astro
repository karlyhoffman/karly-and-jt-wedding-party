---
import { Image } from 'astro:assets';
import photo from '../../assets/homepage/hero-tall.avif';
import '../../styles/components/hero.scss';
---

<section class="hero">
  <hero-animation>
    <div class="hero__title">
      <h2 data-headline>
        <span class="group">
          <span class="script text text--jt">JT</span>
          <span class="text text--and">and</span>
          <span class="script text text--karly">Karly</span>
        </span>
        <span class="text text--married">
          got married!
        </span>
      </h2>
    </div>
    <div class="hero__img gradient" data-bg-img>
      <Image
        src={photo}
        widths={[240, 540, 720, photo.width]}
        priority
        quality={100}
        sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${photo.width}px`}
        alt="The couple kissing with champagne glasses in hand with the sunset and mountains in the background."
      />
    </div>
  </hero-animation>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  class Animation extends HTMLElement {
    $element: any;
    $headline: any;
    $bgImg: any;

    connectedCallback() {
      this.init();
    }

    init() {
			this.$element = this;

      this.createRefs().enable();

      return this;
    }

    createRefs() {
      this.$headline = this.querySelector('[data-headline]');
      this.$bgImg = this.querySelector('[data-bg-img]');
			
      return this;
    }

    enable() {
      // this.pinText();
      this.revealImg();

      return this;
    }

    pinText() {
      ScrollTrigger.create({
        trigger: "body",
        pin: this.$headline,
        start: "top top",
        endTrigger: this.$bgImg,
        end: "27% 50%",
      });
    }

    revealImg() {
      gsap.to(this.$bgImg, {
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: 'body',
          start: 'top top',
          endTrigger: this.$headline,
          end: 'bottom 40%',
          scrub: 0.5,
        },
      });
    }
  }

  customElements.define('hero-animation', Animation);
</script>
