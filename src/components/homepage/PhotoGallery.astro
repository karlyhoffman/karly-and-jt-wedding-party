---
import { Image } from 'astro:assets';
import '@splidejs/splide/css';
import '../../styles/components/photo-gallery.scss';

// Dynamically import all images from the gallery directory
const imageModules = import.meta.glob('../../assets/homepage/gallery/*.jpg', {
  eager: true,
  import: 'default',
});

const images =
  Object.entries(imageModules).map(([path, image], index) => ({
    path,
    src: image,
    alt: `Wedding photo ${index + 1}`,
  })) || [];
---

{
  !!images?.length && (
    <photo-gallery>
      <div
        thumb-slider
        class="splide"
        aria-label="The carousel with thumbnails. Selecting a thumbnail will change the photo in the carousel."
      >
        <div class="splide__track">
          <ul class="splide__list">
            {images.map((image: any, index: number) => (
              <li class="splide__slide thumb__slide">
                <Image
                  src={image.src}
                  alt={image.alt || ''}
                  class="thumb__slide__photo"
                  widths={[240, 540, 720, image.src.width]}
                  sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 1200px, ${image.src.width}px`}
                  priority={index < 10}
                />
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div
        main-slider
        class="splide"
        aria-label="Carousel of photos taken at the couple\'s wedding."
      >
        <div class="splide__track">
          <ul class="splide__list">
            {images.map((image: any, index: number) => (
              <li class="splide__slide main__slide">
                <Image
                  src={image.src}
                  alt={image.alt || ''}
                  class="main__slide__photo"
                  widths={[240, 540, 720, image.src.width]}
                  sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 1200px, ${image.src.width}px`}
                  priority={index < 10}
                />
                <div class="button-menu">
                  <button
                    data-arrow-prev
                    class="btn"
                    type="button"
                    aria-label="Previous slide"
                    aria-controls="splide01-track"
                  >
                    Previous
                  </button>
                  <a
                    class="btn"
                    href={image.src.src || '#'}
                    download={`Photo ${index + 1} of ${images.length}`}
                  >
                    Download
                  </a>
                  <button
                    class="btn"
                    data-arrow-next
                    type="button"
                    aria-label="Next slide"
                    aria-controls="splide01-track"
                  >
                    Next
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </photo-gallery>
  )
}

<script>
  import Splide from '@splidejs/splide';

  class PhotoGallery extends HTMLElement {
    $element: any;
    $mainPhotos: any;
    $thumbPhotos: any;
    $arrowsPrev: any;
    $arrowsNext: any;
    mainSlider: any;
    thumbSlider: any;

    connectedCallback() {
      this.init();
    }

    init() {
      this.$element = this;

      this.layout().enable();

      return this;
    }

    layout() {
      this.$mainPhotos = this.$element.querySelector('[main-slider]');
      this.$thumbPhotos = this.$element.querySelector('[thumb-slider]');
      this.$arrowsPrev = [...this.$element.querySelectorAll('[data-arrow-prev]')];
      this.$arrowsNext = [...this.$element.querySelectorAll('[data-arrow-next]')];

      return this;
    }

    enable() {
      if (!this.$mainPhotos || !this.$thumbPhotos) return;

      this.mainSlider = new Splide(this.$mainPhotos, {
        type: 'loop',
        perPage: 1,
        perMove: 1,
        pagination: false,
        arrows: false,
        rewind: true,
        speed: 600,
      });

      this.$arrowsPrev.forEach((arrow: any) => {
        arrow.addEventListener('click', () => this.mainSlider.go('<'));
      });

      this.$arrowsNext.forEach((arrow: any) => {
        arrow.addEventListener('click', () => this.mainSlider.go('>'));
      });

      this.thumbSlider = new Splide(this.$thumbPhotos, {
        type: 'loop',
        drag: false,
        pagination: false,
        isNavigation: true,
        rewind: true,
        perPage: 9,
        gap: 5,
        speed: 200,
        focus: 'center',
        breakpoints: {
          992: {
            perPage: 6,
          },
          640: {
            perPage: 4,
          },
        },
      });

      this.mainSlider.sync(this.thumbSlider);
      this.mainSlider.mount();
      this.thumbSlider.mount();

      return this;
    }
  }

  customElements.define('photo-gallery', PhotoGallery);
</script>
