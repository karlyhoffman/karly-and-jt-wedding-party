---
import { Image } from 'astro:assets';
import '@splidejs/splide/css';
import '../../styles/components/photo-gallery.scss';

// Dynamically import all images from the gallery directory
const imageModules = import.meta.glob('../../assets/homepage/gallery/*.jpg', {
  eager: true,
  import: 'default',
});

const images = Object.entries(imageModules).map(([path, image], index) => ({
    path,
    src: image,
    alt: `Wedding photo ${index + 1}`,
  }
)) || [];
---

{!!images?.length && (
  <photo-gallery>
    <div
      main-slider
      class="splide"
      aria-label="Carousel of photos taken at the couple\'s wedding."
    >
      <div class="splide__track">
        <ul class="splide__list">
          {images.map((image: any) => (
            <li class="splide__slide main__slide">
              <Image
                src={image.src}
                alt={image.alt || ''}
                class="carousel__photo"
                widths={[240, 540, 720, image.src.width]}
                sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.src.width}px`}
                priority={false}
              />
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      thumb-slider
      class="splide"
      aria-label="The carousel with thumbnails. Selecting a thumbnail will change the photo in the carousel."
    >
      <div class="splide__track">
        <ul class="splide__list">
          {images.map((image: any) => (
            <li class="splide__slide thumb__slide">
              <Image
                src={image.src}
                alt={image.alt || ''}
                class="thumb__slide__photo"
                widths={[240, 540, 720, image.src.width]}
                sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.src.width}px`}
                priority={false}
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </photo-gallery>
)}

<script>
  import Splide from '@splidejs/splide';

  class PhotoGallery extends HTMLElement {
    $element: any;
    $mainPhotos: any;
    $thumbPhotos: any;
    mainSlider: any;
    thumbSlider: any;

    connectedCallback() {
      this.init();
    }

    init() {
			this.$element = this;

      this.layout().enable();

      return this;
    }

    layout() {
			this.$mainPhotos = this.$element.querySelector('[main-slider]');
      this.$thumbPhotos = this.$element.querySelector('[thumb-slider]');

      return this;
    }

    enable() {
      if (!this.$mainPhotos || !this.$thumbPhotos) return;

      this.mainSlider = new Splide(this.$mainPhotos, {
        type: 'loop',
        perPage: 1,
        perMove: 1,
        pagination: false,
        arrows: false,
        rewind: true,
      });

      this.thumbSlider = new Splide(this.$thumbPhotos, {
        gap: 3,
        focus: 'center',
        rewind: true,
        pagination: false,
        isNavigation: true,
        perPage: 9,
        breakpoints: {
          992: {
            perPage: 6,
          },
          640: {
            perPage: 4,
          },
        },
      });

      this.mainSlider.sync(this.thumbSlider);
      this.mainSlider.mount();
      this.thumbSlider.mount();

      return this;
    }
  }

  customElements.define('photo-gallery', PhotoGallery);
</script>
