---
import { getAccessToken, getPlaylistAlbums, type Album } from '../../lib/spotify';
import '../../styles/components/music.scss';

const PLAYLIST_ID = '2uME1BuGAZBt2CoJ1B7qrZ';
const PLAYLIST_URL = `https://open.spotify.com/playlist/${PLAYLIST_ID}`;

let albums: Album[] = [];
let hasError = false;

try {
  const token = await getAccessToken();
  albums = await getPlaylistAlbums(PLAYLIST_ID, token);
} catch (error) {
  console.error('Error fetching Spotify albums:', error);
  hasError = true;
}
---

<a class="music-cta" href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">
  Listen on Spotify →
</a>

{hasError ? (
  <p>
    Couldn't load the album showcase right now.
    You can still <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">open the playlist on Spotify</a>.
  </p>
) : (
  <ul class="album-grid">
    {albums.map((album) => (
      <li class="album-tile">
        {album.imageUrl ? (
          <img
            class="album-tile__img"
            src={album.imageUrl}
            alt={album.name}
            loading="lazy"
            decoding="async"
            width="300"
            height="300"
          />
        ) : (
          <div class="album-tile__img" aria-hidden="true" />
        )}
        <p class="album-tile__name">{album.name}</p>
        <p class="album-tile__artist">{album.artists}</p>
      </li>
    ))}
  </ul>
)}
