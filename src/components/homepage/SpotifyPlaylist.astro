---
import { getAccessToken, getPlaylistItems, type Track } from '../../lib/spotify';
import '../../styles/components/music.scss';

let songs: Track[] = [];
let hasError = false;

const { playlistId = '', title, reverse = false } = Astro.props;
const PLAYLIST_URL = `https://open.spotify.com/playlist/${playlistId}`;

try {
  const token = await getAccessToken();
  songs = await getPlaylistItems(playlistId, token);
} catch (error) {
  console.error('Error fetching Spotify tracks:', error);
  hasError = true;
}
---

{title && (
  <div class="album-marquee__title">
    <h2 class="border-t border-b heading heading--md serif">
      <a class="music-cta" href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">
        {title}
      </a>
    </h2>
  </div>
)}

<div class="album-marquee">
  {
    hasError ? (
      <p>
        Couldn't load the playlist right now. View it on{' '}
        <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">
          Spotify
        </a>{' '}
        instead.
      </p>
    ) : (
      <ul class={"album-marquee__track " + (reverse ? "album-marquee__track--reverse" : "")}>
        {[...songs, ...songs].map(({ artists, imageUrl, songTitle, songUrl }) => (
          <li class="album-tile" aria-hidden="true">
            <a
              href={songUrl || PLAYLIST_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="album-tile__link"
              tabindex="-1"
            >
              <p class="album-tile__name heading heading--sm serif">{songTitle}</p>
              {imageUrl ? (
                <img
                  class="album-tile__img"
                  src={imageUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="300"
                  height="300"
                />
              ) : (
                <div class="album-tile__img" aria-hidden="true" />
              )}
              <p class="album-tile__artist heading heading--sm serif">{artists}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>
