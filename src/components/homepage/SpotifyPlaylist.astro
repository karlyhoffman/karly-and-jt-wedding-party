---
import { getAccessToken, getPlaylistItems, type Track } from '../../lib/spotify';
import '../../styles/components/music.scss';

const PLAYLIST_ID = '2uME1BuGAZBt2CoJ1B7qrZ';
const PLAYLIST_URL = `https://open.spotify.com/playlist/${PLAYLIST_ID}`;

let songs: Track[] = [];
let hasError = false;

try {
  const token = await getAccessToken();
  songs = await getPlaylistItems(PLAYLIST_ID, token);
} catch (error) {
  console.error('Error fetching Spotify tracks:', error);
  hasError = true;
}
---

{hasError ? (
  <p>
    Couldn't load the playlist right now. View it on <a href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">Spotify</a> instead.
  </p>
) : (
  <ul class="album-grid">
    {songs.map(({ artists, imageUrl, songTitle, songUrl }) => (
      <li class="album-tile">
        <a
          href={songUrl || PLAYLIST_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="album-tile__link"
        >
          {imageUrl ? (
            <img
              class="album-tile__img"
              src={imageUrl}
              alt={songTitle}
              loading="lazy"
              decoding="async"
              width="300"
              height="300"
            />
          ) : (
            <div class="album-tile__img" aria-hidden="true" />
          )}
    
          <p class="album-tile__name heading heading--sm serif">{songTitle}</p>
          <p class="album-tile__artist heading heading--sm serif">{artists}</p>
        </a>
      </li>
    ))}
  </ul>
)}

<a class="music-cta" href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">
  Listen on Spotify →
</a>
