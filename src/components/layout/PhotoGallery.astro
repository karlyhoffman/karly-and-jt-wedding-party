---
import { Image } from 'astro:assets';
// import Carousel from '../../components/layout/Carousel.astro';
import '../../styles/components/photo-gallery.scss';

const imageModules = import.meta.glob('../../assets/homepage/gallery/*.jpg', {
  eager: true,
  import: 'default',
});

const images = Object.entries(imageModules).map(([path, image], index) => ({
    path,
    src: image,
    alt: `Wedding photo ${index + 1}`,
  }
));
---

{!!images?.length && (
  <div class="gallery">
    {/* <Carousel images={images} priority={true} /> */}
    
    <div class="grid">
      {images.map((image: any, index) => (
        <div class="grid__item">
          <a href={image.path.replace('../../assets', '/src/assets')} target="_blank" rel="noopener noreferrer">
            <Image
              src={image.src}
              alt={image.alt || ''}
              class="grid__item__photo"
              widths={[500]}
            />
          </a>
        </div>
      ))}
    </div>

    {/* <ul class="flex">
      {images.map((image: any) => (
        <li class="flex__item">
          <Image
            src={image.src}
            alt={image.alt || ''}
            class="flex__item__photo"
            widths={[240, 540, 720, image.src.width]}
            sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${image.src.width}px`}
          />
        </li>
      ))}
    </ul> */}
  </div>
)}
