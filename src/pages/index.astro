---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/homepage/Hero.astro';
import Intro from '../components/homepage/Intro.astro';
import Outro from '../components/homepage/Outro.astro';
import PhotoGallery from '../components/homepage/PhotoGallery.astro';
import SpotifyPlaylist from '../components/homepage/SpotifyPlaylist.astro';
import Section from '../components/layout/BodySection.astro';

const title = "Karly & JT Got Married!";
---

<Layout title={title}>
	<ul slot="nav-items">
		<li><a href="#intro">Intro</a></li>
		<li><a href="#photos">Photos</a></li>
		<li><a href="#playlists">Music</a></li>
		<li><a href="#thank-you">Thank You</a></li>
	</ul>

	<Hero />
	<Intro />

	<Section title="Photo Gallery" id="photos">
		<p>We're so excited to share these memories with you!</p>
		<p>Most of the photos are from the film cameras that were available at the reception that night. You can download the contact sheets from each camera <a href="/gallery/contact-sheets.zip" download="contact-sheets.zip">here</a>.</p>
		<Fragment slot="wide-content">
			<PhotoGallery />
		</Fragment>
	</Section>

	<Section title="Music" id="playlists">
		<p>Here are the songs from the playlist that night. ❤️</p>
		<p>(We needed about four more receptions to play through its entirety, as it ended up being over 19 hours long...)</p>
		<SpotifyPlaylist />
	</Section>

	<Outro />

	<p slot="footer-copy">Website built with ❤️ by <a href="mailto:karlyhoffman@gmail.com" target="_blank">Karly</a>. (Missed the previous version? View it <a href="/archive">here</a>.)</p>
</Layout>