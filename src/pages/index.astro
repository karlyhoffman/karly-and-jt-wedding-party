---
import Layout from '../layouts/Layout.astro';
import Navigation from '../layouts/Navigation.astro';
import Hero from '../components/homepage/Hero.astro';
import Intro from '../components/homepage/Intro.astro';
import Outro from '../components/homepage/Outro.astro';
import Section from '../components/layout/BodySection.astro';

const title = "Karly & JT Got Married!";
---

<Layout title={title}>
	<Navigation>
		<li><a href="#intro">Intro</a></li>
		<li><a href="#photos">Photos</a></li>
		<li><a href="#playlist">Music</a></li>
	</Navigation>

	<Hero />

	<Intro />

	<Section title="Photo Gallery" id="photos">
		<Fragment slot="small-text">Karly is currently working on this section.</Fragment>
		<h3><strong>[Under Construction]</strong></h3>
		<p>Please be patient as Karly builds out this section. She'll send an email notification to those who attended the reception once the photo gallery is complete.</p>
		<p>In the meantime, enjoy these few photos from the reception!</p>
	</Section>

	<Section title="Music" id="playlist">
		<Fragment slot="small-text">This section is coming soon.</Fragment>
		<h3><strong>[Under Construction]</strong></h3>
		<p>Please be patient as Karly builds out this section, too!</p>
		<p>In the meantime, dance your heart away to the <a href="https://open.spotify.com/playlist/2uME1BuGAZBt2CoJ1B7qrZ" target="_blank">reception playlist</a> that was played that night. We needed about four more receptions to play through the whole thing, as it ended up being over 19 hours long...</p>
	</Section>

	<Outro />

	<p slot="footer-copy">Website built with ❤️ by <a href="mailto:karlyhoffman@gmail.com" target="_blank">Karly</a>. (Missed the previous version? View it <a href="/archive">here</a>.)</p>
</Layout>