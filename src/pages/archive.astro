---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/archive/Hero.astro';
import Intro from '../components/archive/Intro.astro';
import ReceptionDetails from '../components/archive/ReceptionDetails.astro';
import RSVP from '../components/archive/RSVP.astro';
import Registry from '../components/archive/Registry.astro';
import Venue from '../components/archive/Venue.astro';
import FAQs from '../components/archive/FAQs.astro';
import Outro from '../components/archive/Outro.astro';

const title = "Archived View (Pre-Wedding)";
---

<Layout title={title}>
	<ul slot="nav-items">
		<li><a href="#intro">Intro</a></li>
		<li><a href="#details">Details</a></li>
		<li><a href="#rsvp">RSVP</a></li>
		<li><a href="#faqs">FAQs</a></li>
	</ul>

	<Hero />
	<Intro />
	<ReceptionDetails />
	<RSVP />
	<Registry />
	<Venue />
	<FAQs />
	<Outro />

  <p slot="footer-copy">
    Website built with ❤️ by <a href="https://www.karlyhoffman.com" target="_blank">Karly</a>.
    <br />
    <br />
    (<a href="/">Current Site</a>)
  </p>
</Layout>
